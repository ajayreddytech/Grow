# --- Firebase (Settings > Cloud sync). Leave blank to run in Guest / Local Storage mode. ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Optional AI provider for grammar correction + categorization. ---
# Without a key, Grow uses its built-in on-device simulation helper.
# WARNING: VITE_* variables are bundled into client JS. Only use personal keys locally,
# or point VITE_AI_PROXY_URL at your own backend that holds the key.
VITE_AI_PROVIDER=          # "anthropic" | "openai" | "" (simulation)
VITE_ANTHROPIC_API_KEY=
VITE_OPENAI_API_KEY=
VITE_AI_PROXY_URL=
